@page "/grill"
@using System.Text.Json
@inject GrillRpcService Rpc
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Grill — OpenPit32</PageTitle>

@if (health is null && !polledOnce)
{
    <p class="text-muted">Connecting to the grill bridge…</p>
}
else if (health is null)
{
    <div class="alert alert-warning">
        Grill bridge unreachable — start <code>scripts\grill_sidecar.py</code>.
    </div>
    <button class="btn btn-outline-secondary" @onclick="PollSidecar">Retry</button>
    <a class="btn btn-outline-secondary ms-1" href="/">Back</a>
}
else if (!health.configured)
{
    <div class="alert alert-warning">
        The bridge has no grill password yet — go <a href="/">back</a> and fetch it
        from your Pit Boss account.
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">@(info?.model ?? "Grill")</h3>
        <div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="PollSidecar">Refresh</button>
            <a class="btn btn-outline-secondary btn-sm ms-1" href="/">Back</a>
        </div>
    </div>
    @if (info is not null)
    {
        <p class="text-muted small">
            @info.board_id
            @if (info.firmware is { } fw)
            {
                <span>· fw @FirmwareText(fw)</span>
            }
        </p>
    }

    @if (live is not null)
    {
        <div class="card pb-card mb-4">
            <div class="card-header">
                Live Status
                <span class="text-muted small ms-2">
                    @if (stateAge is not null)
                    {
                        <span>@stateAge s ago</span>
                    }
                </span>
                <span class="badge @(live.moduleIsOn ? "text-bg-success" : "text-bg-secondary") ms-2">
                    Power @(live.moduleIsOn ? "on" : "off")
                </span>
                <span class="badge @LinkBadgeClass ms-1" title="Bluetooth LE through the ESP32 proxy — works with the controller off">@LinkLabel</span>
                @if (!string.IsNullOrEmpty(LinkProblem))
                {
                    <span class="badge text-bg-warning ms-1">@LinkProblem</span>
                }
            </div>
            <div class="card-body">
                <div class="row text-center pb-temps">
                    <div class="col">
                        <div class="pb-big">@Fmt(live.grillTemp)°</div>
                        <div class="text-muted small">Grill Temp</div>
                    </div>
                    <div class="col">
                        <div class="pb-big">@Fmt(live.grillSetTemp)°</div>
                        <div class="text-muted small">Set Point</div>
                    </div>
                    <div class="col">
                        <div class="pb-big">@Fmt(live.smokerActTemp)°</div>
                        <div class="text-muted small">Smoker</div>
                    </div>
                    <div class="col">
                        <div class="pb-big">@(live.isFahrenheit ? "°F" : "°C")</div>
                        <div class="text-muted small">Units</div>
                    </div>
                </div>
                <hr />
                <div class="row text-center pb-temps">
                    @foreach (var p in ModelProbes(live))
                    {
                        <div class="col">
                            <div class="pb-big">@Fmt(p.Value)°</div>
                            <div class="text-muted small">Probe @p.Key</div>
                        </div>
                    }
                </div>
                <hr />
                <p class="mb-0 text-muted small">
                    Fan @OnOff(live.fanState) · Igniter @OnOff(live.hotState)
                    · Auger @OnOff(live.motorState) · Light @OnOff(live.lightState)
                    · Prime @OnOff(live.primeState)
                    @if (AnyError(live))
                    {
                        <span class="badge text-bg-danger ms-1">Error flags set</span>
                    }
                </p>
            </div>
        </div>
    }
    else if (string.IsNullOrEmpty(LinkProblem))
    {
        <div class="alert alert-secondary">No status data from the grill yet.</div>
    }
    else
    {
        <div class="alert alert-warning">
            <span class="badge @LinkBadgeClass me-1">@LinkLabel</span>
            @LinkProblem
        </div>
    }

    <div class="card pb-card">
        <div class="card-header">Controls</div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(actionMessage))
            {
                <div class="alert @(actionFailed ? "alert-danger" : "alert-info") py-2">@actionMessage</div>
            }
            <div class="row g-2 align-items-end">
                <div class="col-6 col-md-3">
                    <label class="form-label small text-muted mb-1">Target temp (@(live?.isFahrenheit == true ? "F" : "C"))</label>
                    <input type="number" class="form-control" placeholder="e.g. 250" @bind="setTemp" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-outline-secondary" disabled="@actionBusy" @onclick="SetTemp">Set Temperature</button>
                </div>
            </div>
            <div class="row g-2 mt-3">
                <div class="col-auto">
                    @if (live?.moduleIsOn == true)
                    {
                        <button class="btn @(confirmFor == "power_off" ? "btn-danger" : "btn-outline-danger")"
                                disabled="@actionBusy" @onclick="PowerOff">
                            @(confirmFor == "power_off" ? "Confirm Power Off?" : "Power Off")
                        </button>
                    }
                    else
                    {
                        <button class="btn @(confirmFor == "power_on" ? "btn-danger" : "btn-outline-danger")"
                                disabled="@actionBusy" @onclick="PowerOn">
                            @(confirmFor == "power_on" ? "Confirm Power On (ignites)?" : "Power On")
                        </button>
                    }
                </div>
                @if (info is null || info.has_lights)
                {
                    <div class="col-auto">
                        <button class="btn btn-outline-secondary" disabled="@actionBusy" @onclick="ToggleLight">
                            Light @(live?.lightState == true ? "Off" : "On")
                        </button>
                    </div>
                }
                <div class="col-auto">
                    <button class="btn btn-outline-secondary" disabled="@actionBusy" @onclick="TogglePrime">
                        Prime @(live?.primeState == true ? "Off" : "On")
                    </button>
                </div>
            </div>
            <p class="text-muted small mt-3 mb-0">
                Commands go over Bluetooth LE through the ESP32 proxy — no cloud involved.
                They act on a real appliance; double-check before confirming.
            </p>
        </div>
    </div>

    @if (info?.error_display_threshold is not null)
    {
        <div class="card pb-card mt-4">
            <div class="card-header">Link Settings</div>
            <div class="card-body">
                <p class="text-muted small">
                    A single failed status check is expected occasionally — the grill's
                    auth key rotates every 10 seconds, and a request that lands right on
                    that boundary can be rejected even though nothing's actually wrong —
                    and it clears itself on its own moments later. This sets how many in
                    a row have to fail before it's shown as a warning above.
                </p>
                <div class="row g-2 align-items-end">
                    <div class="col-auto" style="width:8rem">
                        <label class="form-label small text-muted mb-1">Consecutive failures</label>
                        <input type="number" class="form-control form-control-sm" min="1" max="60"
                               @bind="errorThresholdText" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-outline-secondary btn-sm" disabled="@errorThresholdBusy"
                                @onclick="SaveErrorThreshold">
                            Save
                        </button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(errorThresholdError))
                {
                    <div class="alert alert-danger py-2 mt-2 mb-0">@errorThresholdError</div>
                }
            </div>
        </div>
    }

    <div class="card pb-card mt-4">
        <div class="card-header">Alarms</div>
        <div class="card-body">
            @if (!pushSupported)
            {
                <p class="text-muted small mb-3">
                    This browser can't do push notifications here (no secure context,
                    or an old browser) — alarms still fire and clear below, but only
                    while this page is open.
                </p>
            }
            else if (pushSubscribed)
            {
                <p class="text-muted small mb-3">✓ Notifications are enabled on this device.</p>
            }
            else if (pushPermission == "denied")
            {
                <p class="text-muted small mb-3">
                    Notifications are blocked for this site — allow them in your browser's
                    site settings, then reload this page.
                </p>
            }
            else
            {
                <div class="mb-3">
                    <button class="btn btn-outline-secondary btn-sm" disabled="@notifBusy"
                            @onclick="EnableNotifications">
                        Enable notifications
                    </button>
                </div>
            }
            @if (!string.IsNullOrEmpty(notifError))
            {
                <div class="alert alert-danger py-2">@notifError</div>
            }

            @if (alarms.Count > 0)
            {
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var a in alarms)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <strong>@a.label</strong>
                                <span class="text-muted small ms-2">@DescribeAlarm(a)</span>
                            </span>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAlarm(a.id)">✕</button>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted small">No alarms set.</p>
            }

            @if (!string.IsNullOrEmpty(alarmError))
            {
                <div class="alert alert-danger py-2">@alarmError</div>
            }

            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label small text-muted mb-1">Alarm type</label>
                    <select class="form-select form-select-sm" @bind="alarmKind">
                        <option value="temp">Temperature</option>
                        <option value="timer">Timer</option>
                    </select>
                </div>
                @if (alarmKind == "temp")
                {
                    <div class="col-auto">
                        <label class="form-label small text-muted mb-1">Sensor</label>
                        <select class="form-select form-select-sm" @bind="alarmSensor">
                            @foreach (var s in AvailableSensors())
                            {
                                <option value="@s.Key">@s.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <label class="form-label small text-muted mb-1">When it</label>
                        <select class="form-select form-select-sm" @bind="alarmComparison">
                            <option value="at_or_above">reaches or exceeds</option>
                            <option value="at_or_below">drops to or below</option>
                        </select>
                    </div>
                    <div class="col-auto" style="width:6.5rem">
                        <label class="form-label small text-muted mb-1">Target (@(live?.isFahrenheit == true ? "F" : "C"))</label>
                        <input type="number" class="form-control form-control-sm" @bind="alarmTargetText" placeholder="e.g. 250" />
                    </div>
                }
                else
                {
                    <div class="col-auto" style="width:6.5rem">
                        <label class="form-label small text-muted mb-1">Minutes</label>
                        <input type="number" class="form-control form-control-sm" @bind="alarmMinutesText" placeholder="e.g. 45" />
                    </div>
                }
                <div class="col-auto" style="width:10rem">
                    <label class="form-label small text-muted mb-1">Label (optional)</label>
                    <input class="form-control form-control-sm" @bind="alarmLabel" placeholder="e.g. Brisket" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-outline-secondary btn-sm" disabled="@alarmBusy" @onclick="AddAlarm">Add Alarm</button>
                </div>
            </div>
            <p class="text-muted small mt-3 mb-0">
                Alarms are checked and pushed by the grill bridge, so they still fire
                (as a device notification) if this tab isn't open — as long as the
                bridge itself keeps running.
            </p>
        </div>
    </div>
}

@code {
    private string? setTemp;
    private SidecarState? live;
    private double? stateAge;
    private string? sidecarError;
    private SidecarHealthResponse? health;
    private SidecarInfoResponse? info;
    private bool polledOnce;
    private string? confirmFor;
    private string? actionMessage;
    private bool actionFailed;
    private bool actionBusy;
    private System.Threading.Timer? pollTimer;

    // ---- Link Settings card (error_display_threshold, ESP32-only) ----
    private string? errorThresholdText = "5";
    private bool errorThresholdLoaded;
    private bool errorThresholdBusy;
    private string? errorThresholdError;
    private System.Threading.Timer? confirmTimer;

    // ---- Alarms card ----
    private List<AlarmDto> alarms = new();
    private string? alarmError;
    private string alarmKind = "temp";
    private string alarmSensor = "grillTemp";
    private string alarmComparison = "at_or_above";
    private string? alarmTargetText;
    private string? alarmMinutesText;
    private string? alarmLabel;
    private bool alarmBusy;

    private IJSObjectReference? pushModule;
    private bool pushSupported;
    private string pushPermission = "default";
    // Whether the sidecar currently holds a working subscription for this
    // device — NOT the same as pushPermission == "granted": permission can
    // be granted while the underlying PushSubscription is gone (e.g. site
    // storage was cleared, or the sidecar's own volume was reset), and the
    // card must still offer a way back in rather than showing nothing.
    private bool pushSubscribed;
    private bool notifBusy;
    private string? notifError;

    protected override async Task OnInitializedAsync()
    {
        pollTimer = new System.Threading.Timer(_ => _ = InvokeAsync(PollSidecar),
            null, TimeSpan.Zero, TimeSpan.FromSeconds(5));

        try
        {
            pushModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/push.js");
            pushSupported = await pushModule.InvokeAsync<bool>("isSupported");
            if (pushSupported)
            {
                pushPermission = await pushModule.InvokeAsync<string>("permission");
                if (pushPermission == "granted")
                {
                    // Best-effort: if the browser already holds a subscription
                    // (e.g. the sidecar's own copy was lost to a volume reset),
                    // re-register it instead of silently losing this alarm's alerts.
                    var existing = await pushModule.InvokeAsync<JsonElement?>("getExistingSubscription");
                    if (existing is { ValueKind: JsonValueKind.Object } sub)
                    {
                        pushSubscribed = await Rpc.SubscribePushAsync(sub);
                    }
                }
            }
        }
        catch (JSException)
        {
            pushSupported = false;
        }
    }

    private async Task PollSidecar()
    {
        try
        {
            health = await Rpc.GetHealthAsync();
            if (health is not null)
            {
                // Timer alarms need no configured grill, only the clock — refresh
                // the list regardless of `configured`.
                alarms = (await Rpc.GetAlarmsAsync())?.alarms ?? alarms;
            }
            if (health?.configured == true)
            {
                info ??= await Rpc.GetInfoAsync();
                // Prefill once from the ESP32's current value, not on every
                // poll — otherwise an in-progress edit (or a save that just
                // hasn't round-tripped into `info` yet) would keep getting
                // overwritten out from under the user.
                if (!errorThresholdLoaded && info?.error_display_threshold is int t)
                {
                    errorThresholdText = t.ToString();
                    errorThresholdLoaded = true;
                }
                var resp = await Rpc.GetStateAsync();
                live = resp?.state;
                stateAge = resp?.state_age_seconds;
                sidecarError = resp?.last_error;
            }
        }
        catch (Exception ex)
        {
            sidecarError = "sidecar unreachable: " + ex.Message;
            health = null;
        }
        polledOnce = true;
        StateHasChanged();
    }

    private async Task EnableNotifications()
    {
        if (pushModule is null) return;
        notifBusy = true;
        notifError = null;
        try
        {
            pushPermission = await pushModule.InvokeAsync<string>("requestPermission");
            if (pushPermission != "granted")
            {
                if (pushPermission == "denied")
                    notifError = "Notifications are blocked for this site.";
                return;
            }
            var vapidKey = await Rpc.GetVapidPublicKeyAsync();
            if (string.IsNullOrEmpty(vapidKey))
            {
                notifError = "Could not reach the grill bridge for the push key.";
                return;
            }
            var subscription = await pushModule.InvokeAsync<JsonElement>("subscribe", vapidKey);
            pushSubscribed = await Rpc.SubscribePushAsync(subscription);
            if (!pushSubscribed)
                notifError = "The grill bridge rejected the subscription.";
        }
        catch (Exception ex)
        {
            notifError = "Enabling notifications failed: " + ex.Message;
        }
        finally
        {
            notifBusy = false;
        }
    }

    private async Task AddAlarm()
    {
        alarmError = null;
        AlarmResponse r;
        if (alarmKind == "temp")
        {
            if (!int.TryParse(alarmTargetText, out var target))
            {
                alarmError = "Enter a target temperature.";
                return;
            }
            alarmBusy = true;
            try { r = await Rpc.AddTempAlarmAsync(alarmSensor, alarmComparison, target, alarmLabel); }
            finally { alarmBusy = false; }
        }
        else
        {
            if (!int.TryParse(alarmMinutesText, out var minutes) || minutes <= 0)
            {
                alarmError = "Enter a number of minutes.";
                return;
            }
            alarmBusy = true;
            try { r = await Rpc.AddTimerAlarmAsync(minutes * 60, alarmLabel); }
            finally { alarmBusy = false; }
        }
        if (!r.ok)
        {
            alarmError = r.error ?? "Could not add the alarm.";
            return;
        }
        alarmTargetText = null;
        alarmMinutesText = null;
        alarmLabel = null;
        await RefreshAlarms();
    }

    private async Task RemoveAlarm(string id)
    {
        await Rpc.DeleteAlarmAsync(id);
        await RefreshAlarms();
    }

    private async Task RefreshAlarms()
    {
        try { alarms = (await Rpc.GetAlarmsAsync())?.alarms ?? alarms; }
        catch { /* PollSidecar's own error banner already covers connectivity */ }
        StateHasChanged();
    }

    private IEnumerable<(string Key, string Label)> AvailableSensors()
    {
        yield return ("grillTemp", "Grill Temp");
        yield return ("smokerActTemp", "Smoker Temp");
        var probes = info?.meat_probes is > 0 ? info!.meat_probes : 4;
        for (int i = 1; i <= probes; i++) yield return ($"p{i}Temp", $"Probe {i}");
    }

    private static string SensorLabel(string? sensor) => sensor switch
    {
        "grillTemp" => "Grill Temp",
        "smokerActTemp" => "Smoker Temp",
        "p1Temp" => "Probe 1",
        "p2Temp" => "Probe 2",
        "p3Temp" => "Probe 3",
        "p4Temp" => "Probe 4",
        _ => sensor ?? "Sensor",
    };

    private static string DescribeAlarm(AlarmDto a)
    {
        if (a.kind == "timer")
        {
            var remaining = a.fires_at is { } f
                ? TimeSpan.FromSeconds(Math.Max(0, f - DateTimeOffset.UtcNow.ToUnixTimeSeconds()))
                : TimeSpan.Zero;
            return $"{remaining:hh\\:mm\\:ss} remaining";
        }
        var cmp = a.comparison == "at_or_above" ? "≥" : "≤";
        return $"{SensorLabel(a.sensor)} {cmp} {a.target:0}°";
    }

    private string LinkLabel => health switch
    {
        null => "bridge down",
        { rssi: int r } => $"BLE {r} dBm",
        _ => "BLE",
    };

    private string LinkBadgeClass => health switch
    {
        null => "text-bg-danger",
        { proxy_connected: false } => "text-bg-danger",
        { connected: false } => "text-bg-secondary",
        _ => "text-bg-primary",
    };

    /// <summary>
    /// One line explaining why data may be stale: "proxy down" (fix the
    /// ESP32) versus "grill not heard" (unplugged / out of range).
    /// </summary>
    private string? LinkProblem
    {
        get
        {
            if (health is null) return sidecarError ?? "sidecar unreachable";
            if (!health.proxy_connected)
                return "ESP32 proxy unreachable — check its power/WiFi";
            if (!health.connected)
                return "grill not heard by the proxy — unplugged or out of range?";
            return sidecarError;
        }
    }

    private void PowerOn() => ClickPower("power_on");
    private void PowerOff() => ClickPower("power_off");
    private Task ToggleLight() => Send(live?.lightState == true ? "light_off" : "light_on");
    private Task TogglePrime() => Send(live?.primeState == true ? "prime_off" : "prime_on");

    private void ClickPower(string action)
    {
        if (confirmFor != action)
        {
            confirmFor = action;
            actionFailed = false;
            actionMessage = action == "power_on"
                ? "Power On ignites the grill. Click again to confirm."
                : "Click again to confirm Power Off.";
            confirmTimer?.Dispose();
            confirmTimer = new System.Threading.Timer(_ =>
            {
                confirmFor = null;
                actionMessage = null;
                _ = InvokeAsync(StateHasChanged);
            }, null, TimeSpan.FromSeconds(8), Timeout.InfiniteTimeSpan);
            return;
        }
        confirmFor = null;
        actionMessage = null;
        _ = Send(action);
    }

    private async Task SetTemp()
    {
        if (!int.TryParse(setTemp, out var t))
        {
            actionMessage = "Enter a temperature first.";
            actionFailed = true;
            return;
        }
        await Send("set_temp", t);
    }

    private async Task Send(string action, double? value = null)
    {
        actionBusy = true;
        actionMessage = null;
        actionFailed = false;
        try
        {
            var r = await Rpc.SendCommandAsync(action, value, confirm: true);
            actionMessage = r.ok ? "Command accepted." : r.error;
            actionFailed = !r.ok;
            await PollSidecar();
        }
        catch (Exception ex)
        {
            actionMessage = "sidecar error: " + ex.Message;
            actionFailed = true;
        }
        finally
        {
            actionBusy = false;
        }
    }

    private async Task SaveErrorThreshold()
    {
        errorThresholdError = null;
        if (!int.TryParse(errorThresholdText, out var t) || t < 1 || t > 60)
        {
            errorThresholdError = "Enter a number between 1 and 60.";
            return;
        }
        errorThresholdBusy = true;
        try
        {
            var r = await Rpc.SetErrorDisplayThresholdAsync(t);
            if (!r.ok)
            {
                errorThresholdError = r.error ?? "Failed to save.";
            }
            else if (info is not null)
            {
                // So the badge/threshold stay in sync without waiting for the
                // next poll's round trip back through /info.
                info.error_display_threshold = r.error_display_threshold ?? t;
            }
        }
        catch (Exception ex)
        {
            errorThresholdError = "grill bridge unreachable: " + ex.Message;
        }
        finally
        {
            errorThresholdBusy = false;
        }
    }

    private static IEnumerable<KeyValuePair<int, double?>> Probes(SidecarState s)
    {
        if (s.p1Temp is not null) yield return new(1, s.p1Temp);
        if (s.p2Temp is not null) yield return new(2, s.p2Temp);
        if (s.p3Temp is not null) yield return new(3, s.p3Temp);
        if (s.p4Temp is not null) yield return new(4, s.p4Temp);
    }

    private IEnumerable<KeyValuePair<int, double?>> ModelProbes(SidecarState s) =>
        Probes(s).Where(p => p.Key <= (info?.meat_probes is > 0 ? info.meat_probes : 4));

    private static string OnOff(bool b) => b ? "on" : "off";

    private static bool AnyError(SidecarState s) =>
        s.err1 || s.err2 || s.err3 || s.highTempErr
        || s.fanErr || s.hotErr || s.motorErr || s.erL;

    private static string Fmt(double? v) =>
        v is null ? "—" : v.Value.ToString("0.#");

    private static string FirmwareText(System.Text.Json.JsonElement fw) =>
        fw.ValueKind == System.Text.Json.JsonValueKind.Object
        && fw.TryGetProperty("firmwareVersion", out var v)
            ? v.ToString()
            : fw.ToString();

    public async ValueTask DisposeAsync()
    {
        pollTimer?.Dispose();
        confirmTimer?.Dispose();
        if (pushModule is not null)
        {
            try { await pushModule.DisposeAsync(); }
            catch (JSDisconnectedException) { /* page is already unloading */ }
        }
    }
}
