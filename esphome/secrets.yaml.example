# Copy to esphome/secrets.yaml (git-ignored).
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"
# 32 random bytes, base64 — `openssl rand -base64 32` or ESPHome's generator.
# The same value goes into scripts/.grill_env as GRILL_PROXY_KEY.
api_key: "REPLACE_WITH_BASE64_KEY"
ota_password: "choose-an-ota-password"
# grill-firmware.yaml only (grill-proxy.yaml doesn't reference these). All
# three are just the *initial* fallback as of Phase 7 (docs/
# ESP32_FIRMWARE_PLAN.md) — NVS wins once POST /setup / POST /config have
# run once, so a fresh device can leave these unset and be configured
# entirely through the web app instead.
grill_password: ""
telegram_bot_token: ""
telegram_chat_id: ""
