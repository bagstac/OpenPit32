# Serves the published Blazor WebAssembly SPA and reverse-proxies API
# traffic under /api/, so the whole app is one origin — needed for a single
# Cloudflare Tunnel hostname and so one login covers both. As of Phase 4
# (docs/ESP32_FIRMWARE_PLAN.md) that traffic is split across two backends:
# the sidecar (scripts/grill_sidecar.py) for everything not yet ported, and
# the grill's own ESP32 (esphome/grill-firmware.yaml) for the read-only
# /health, /state, /info it now serves directly — same JSON shapes, so
# OpenPit32/Services/GrillRpcService.cs needs no changes either way.
# /login, /logout, /auth-check still go to the sidecar; that's rollout item
# 8, not done yet.
# Client-side routes (/grill, /health) don't exist as files, so unmatched
# paths fall back to index.html and the Blazor router takes it from there.
#
# This file is an envsubst *.template (docker/web.Dockerfile copies it into
# nginx:alpine's /etc/nginx/templates/, which substitutes ${VAR} before
# nginx starts) so $GRILL_PROXY_HOST only has to be set in one place — the
# same variable docker-compose.yml already passes to the sidecar for this
# exact board. Everything else below stays plain nginx syntax: bare
# $variable (no braces) is an nginx runtime variable, untouched by envsubst.
#
# 127.0.0.11 is Docker Compose's embedded DNS; re-resolving per-request
# (via the $sidecar variable in proxy_pass) rather than once at nginx
# startup means this keeps working if the sidecar container is recreated
# on its own. The grill ESP32 isn't on the compose network — $grill_esp32
# below is a literal LAN IP substituted in at container start, not
# something this resolver looks up.
resolver 127.0.0.11 valid=10s;

# nginx's own $scheme is always "http" here — it never terminates TLS
# itself (that's Cloudflare's edge, for the tunnel path); LAN-direct access
# really is plain HTTP with nothing to reflect either way. Only trust
# X-Forwarded-Proto when it says https, so the login redirect below (which
# has to construct an absolute URL) doesn't tell a tunnel visitor's browser
# to go to a plain-http URL that isn't actually being served.
map $http_x_forwarded_proto $external_scheme {
    default $scheme;
    https   https;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    set $sidecar http://sidecar:8091;
    set $grill_esp32 http://${GRILL_PROXY_HOST};

    # Fixed username/password so the app isn't wide open once it's reachable
    # from the internet (e.g. via a Cloudflare Tunnel) — but as a signed
    # session cookie from a real login FORM (scripts/grill_sidecar.py's
    # /login), not auth_basic's browser-native popup, which most password
    # managers don't offer to fill. auth_request delegates the yes/no
    # decision to the sidecar's /auth-check on every request; AUTH_USERNAME
    # / AUTH_PASSWORD (docker/README.md) configure it there, not here.
    location = /auth-check {
        internal;
        proxy_pass $sidecar/auth-check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    # Unauthenticated on purpose: the login page and its own actions. Must
    # stay outside the auth_request gate below or logging in could never
    # succeed.
    location = /login {
        proxy_pass $sidecar/login;
        proxy_set_header Host $host;
    }

    location = /logout {
        proxy_pass $sidecar/logout;
        proxy_set_header Host $host;
    }

    location @login_redirect {
        return 302 $external_scheme://$host/login?next=$request_uri;
    }

    location / {
        auth_request /auth-check;
        error_page 401 = @login_redirect;
        try_files $uri $uri/ /index.html;
    }

    # /health, /state, /info now come straight from the grill's ESP32
    # (Phase 4) instead of the sidecar — same paths, same JSON shapes, still
    # behind the same login. These three `location =` exact matches take
    # precedence over the /api/ prefix block below regardless of file order,
    # so everything else under /api/ (command, setup, alarms, push, models,
    # probe-targets — not yet ported, rollout items 5-8) keeps going to the
    # sidecar unchanged.
    location = /api/health {
        auth_request /auth-check;
        error_page 401 = @login_redirect;
        proxy_pass $grill_esp32/health;
        proxy_set_header Host $host;
    }

    location = /api/state {
        auth_request /auth-check;
        error_page 401 = @login_redirect;
        proxy_pass $grill_esp32/state;
        proxy_set_header Host $host;
    }

    location = /api/info {
        auth_request /auth-check;
        error_page 401 = @login_redirect;
        proxy_pass $grill_esp32/info;
        proxy_set_header Host $host;
    }

    location /api/ {
        auth_request /auth-check;
        # A session that expires mid-visit surfaces as this redirect's HTML
        # landing where the app expected JSON — GrillRpcService logs that
        # and falls back to its normal "bridge not reachable" state rather
        # than crash, so reloading the page (which redirects the whole page
        # to /login) is what actually recovers it. Fine given 30-day
        # sessions make this rare; not worth a separate JSON-401 path here.
        error_page 401 = @login_redirect;

        # Using a variable in proxy_pass (needed above so nginx re-resolves
        # "sidecar" per request instead of caching its IP at startup) means
        # nginx no longer strips the location prefix on its own — do it
        # explicitly, or every request would arrive at the sidecar as
        # /api/health instead of /health and 404.
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $sidecar;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # nginx:alpine's mime.types already maps .wasm; set it explicitly in
    # case an older image is used, since a wrong type stops the browser
    # from instantiating the module.
    location ~ \.wasm$ {
        default_type application/wasm;
    }

    gzip on;
    gzip_types application/wasm application/octet-stream text/javascript application/javascript;
}
