# Copy to .env in the repo root (git-ignored) and fill in.

# This host's LAN address, and the port nginx serves the app on — together
# they're the origin the browser must load the app from for the sidecar's
# CORS allowlist to match (only relevant for direct LAN-diagnostic access
# to the sidecar's own port 8091; the app itself is one origin behind nginx).
HOST_IP=192.168.1.172
WEB_PORT=5219

# The login the app requires (see docker/README.md for how this is used —
# a real form, not a browser Basic Auth popup, so a password manager can
# fill it). Required: unset, nginx's auth gate denies everyone.
AUTH_USERNAME=
AUTH_PASSWORD=
# Optional: sign session cookies with this instead of an auto-generated,
# persisted one. Set it (to anything) to invalidate every existing session
# at once, e.g. right after changing AUTH_PASSWORD.
#AUTH_SECRET=

# The ESP32 running esphome/grill-proxy.yaml — its LAN IP and the
# api.encryption.key from esphome/secrets.yaml.
GRILL_PROXY_HOST=192.168.1.114
GRILL_PROXY_KEY=base64-noise-key-from-esphome-secrets
#GRILL_PROXY_PORT=6053

# Leave these unset — fetch the grill password from the web app's
# "Pit Boss account" dialog once it's running instead. Only set them here
# to skip that (e.g. scripted redeploys); GRILL_MODEL must still match your
# grill if you do.
#GRILL_BOARD_ID=PBV2-XXXXXXXXXXXX
#GRILL_PASSWORD=
#GRILL_MODEL=PBV5 P2
