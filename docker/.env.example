# Copy to .env in the repo root (git-ignored) and fill in.

# This host's LAN address — where the browser loads the web app from, and
# what the sidecar's CORS allowlist must match. Also where the sidecar
# itself is reachable, since the browser talks to it directly on its own
# port (see OpenPit32/Program.cs).
HOST_IP=192.168.1.172
WEB_PORT=5219

# The ESP32 running esphome/grill-proxy.yaml — its LAN IP and the
# api.encryption.key from esphome/secrets.yaml.
GRILL_PROXY_HOST=192.168.1.114
GRILL_PROXY_KEY=base64-noise-key-from-esphome-secrets
#GRILL_PROXY_PORT=6053

# Leave these unset — fetch the grill password from the web app's
# "Pit Boss account" dialog once it's running instead. Only set them here
# to skip that (e.g. scripted redeploys); GRILL_MODEL must still match your
# grill if you do.
#GRILL_BOARD_ID=PBV2-XXXXXXXXXXXX
#GRILL_PASSWORD=
#GRILL_MODEL=PBV5 P2
