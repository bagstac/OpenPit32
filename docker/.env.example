# Copy to .env in the repo root (git-ignored) and fill in.

# This host's LAN address, and the port nginx serves the app on — together
# they're the origin the browser must load the app from for the auth
# service's CORS allowlist to match (only relevant for direct LAN-diagnostic
# access to its own port 8091; the app itself is one origin behind nginx).
HOST_IP=192.168.1.172
WEB_PORT=5219

# The login the app requires (see docker/README.md for how this is used —
# a real form, not a browser Basic Auth popup, so a password manager can
# fill it). Required: unset, nginx's auth gate denies everyone.
AUTH_USERNAME=
AUTH_PASSWORD=
# Optional: sign session cookies with this instead of an auto-generated,
# persisted one. Set it (to anything) to invalidate every existing session
# at once, e.g. right after changing AUTH_PASSWORD.
#AUTH_SECRET=

# The grill's ESP32 LAN IP (esphome/grill-firmware.yaml) — nginx proxies
# nearly all of /api/* straight to it (docker/nginx.conf.template). The
# grill password itself is NOT set here: use the web app's "Fetch grill
# password" dialog once it's running instead — that calls the ESP32's own
# POST /setup directly (Phase 7), persisted on the ESP32's own flash, not
# anything in this file.
GRILL_PROXY_HOST=192.168.1.114
